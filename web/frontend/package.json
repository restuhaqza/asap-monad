{
  "name": "asap-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run whitepaper",
    "build": "tsc -b && vite build --mode testnet",
    "prebuild": "npm run whitepaper",
    "whitepaper": "node scripts/whitepaper.mjs",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:testnet": "tsc -b && vite build --mode testnet --outDir dist",
    "build:mainnet": "tsc -b && vite build --mode mainnet --outDir dist-mainnet",
    "prebuild:testnet": "npm run whitepaper",
    "prebuild:mainnet": "npm run whitepaper",
    "cf:deploy:testnet": "wrangler deploy -c wrangler.testnet.jsonc",
    "cf:deploy:mainnet": "wrangler deploy -c wrangler.mainnet.jsonc"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
