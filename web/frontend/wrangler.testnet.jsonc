{
  // Testnet deployment: https://testnet.asapmonad.web.id
  // Same worker code and the same R2 bucket as the mainnet host; only the
  // bundle differs, because the chain is chosen at build time, not at runtime.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asap-monad-testnet",
  "main": "worker.ts",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/evidence/*"]
  },
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "asap-evidence"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [{ "pattern": "testnet.asapmonad.web.id", "custom_domain": true }]
}
