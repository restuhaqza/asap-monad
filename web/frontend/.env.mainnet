# Mainnet build. Addresses are written by the mainnet deploy step; until they
# are, config.ts treats them as "not deployed" and refuses to render a mainnet
# address that does not exist.
VITE_NETWORK=mainnet
VITE_REGISTRY=0x0000000000000000000000000000000000000000
VITE_BOUNTY=0x0000000000000000000000000000000000000000
