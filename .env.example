# Deployment / runtime configuration.
# Copy to .env and fill in locally. Never commit .env.

# Deployer key (testnet burner only, never a mainnet key with funds)
PRIVATE_KEY=

# Explorer verification (Monadscan)
MONADSCAN_API_KEY=

# Contracts, filled after `forge script script/Deploy.s.sol`
REGISTRY_ADDRESS=
BOUNTY_ADDRESS=

# Oracle pusher
RPC_URL=https://testnet-rpc.monad.xyz
